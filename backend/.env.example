# Copy to backend/.env if needed. The runtime loads it natively.
# Existing exported environment variables take precedence.
PORT=3000
HOST=127.0.0.1
NODE_ENV=development
# Optional; defaults to backend/data/cybershield.sqlite relative to app.cjs.
# DB_PATH=data/cybershield.sqlite
# Optional exact browser origin; no trailing slash.
# APP_ORIGIN=http://127.0.0.1:3000
# Production requires HTTPS termination and NODE_ENV=production.
